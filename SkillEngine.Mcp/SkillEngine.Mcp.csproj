<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SkillEngine.Mcp</RootNamespace>
    <AssemblyName>SkillEngine.Mcp</AssemblyName>
    <Description>ASP.NET Core MCP-compatible server exposing AI skills as tools.</Description>
