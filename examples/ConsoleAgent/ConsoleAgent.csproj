<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ConsoleAgent</RootNamespace>
    <AssemblyName>ConsoleAgent</AssemblyName>
    <Description>Interactive demo: invokes .NET MCP Skill Engine tools directly without HTTP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SkillEngine.Core\SkillEngine.Core.csproj" />
    <ProjectReference Include="..\..\SkillEngine.Tools\SkillEngine.Tools.csproj" />
  </ItemGroup>

</Project>
