<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SkillEngine.Core</RootNamespace>
    <AssemblyName>SkillEngine.Core</AssemblyName>
    <Description>Core skill engine abstractions, orchestration, and prompt templating for the .NET MCP Skill Engine.</Description>
    <Authors>Yassine Zakhama</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Scriban" Version="7.0.6" />
  </ItemGroup>

</Project>
